{
  "name": "quicksync-sftp",
  "displayName": "QuickSync SFTP",
  "description": "One-click SFTP sync for your workspace",
  "version": "0.1.0",
  "publisher": "Prem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acharyap23/quicksync-sftp.git"
  },
  "bugs": {
    "url": "https://github.com/acharyap23/quicksync-sftp/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ssh",
    "deploy",
    "sync",
    "upload"
  ],
  "activationEvents": [
    "workspaceContains:**/.vscode/quicksync.json"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "node esbuild.js",
    "build": "node esbuild.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "QuickSync reads connection settings from the workspace and opens outbound SFTP connections, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "QuickSync needs a local filesystem to read files and to open SFTP connections, so it does not run in virtual workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "quicksync.syncAll",
        "title": "QuickSync: Sync All to Remote"
      },
      {
        "command": "quicksync.syncChanged",
        "title": "QuickSync: Sync Changed Files"
      },
      {
        "command": "quicksync.initConfig",
        "title": "QuickSync: Create Config File"
      },
      {
        "command": "quicksync.resetHostKey",
        "title": "QuickSync: Reset Host Key"
      },
      {
        "command": "quicksync.clearCredentials",
        "title": "QuickSync: Clear Saved Credentials"
      },
      {
        "command": "quicksync.remote.connect",
        "title": "Connect",
        "category": "QuickSync",
        "icon": "$(plug)"
      },
      {
        "command": "quicksync.remote.disconnect",
        "title": "Disconnect",
        "category": "QuickSync",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "quicksync.remote.refresh",
        "title": "Refresh",
        "category": "QuickSync",
        "icon": "$(refresh)"
      },
      {
        "command": "quicksync.remote.openFile",
        "title": "Open Remote File",
        "category": "QuickSync"
      },
      {
        "command": "quicksync.remote.download",
        "title": "Download",
        "category": "QuickSync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "quicksync.remote.uploadHere",
        "title": "Upload Here…",
        "category": "QuickSync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "quicksync.remote.newFolder",
        "title": "New Folder",
        "category": "QuickSync",
        "icon": "$(new-folder)"
      },
      {
        "command": "quicksync.remote.newFile",
        "title": "New File",
        "category": "QuickSync",
        "icon": "$(new-file)"
      },
      {
        "command": "quicksync.remote.rename",
        "title": "Rename",
        "category": "QuickSync"
      },
      {
        "command": "quicksync.remote.delete",
        "title": "Delete",
        "category": "QuickSync",
        "icon": "$(trash)"
      },
      {
        "command": "quicksync.syncCurrentFile",
        "title": "Sync Current File",
        "category": "QuickSync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "quicksync.syncSelectedFiles",
        "title": "Sync Selected File(s)",
        "category": "QuickSync"
      },
      {
        "command": "quicksync.syncFolder",
        "title": "Sync Folder",
        "category": "QuickSync"
      },
      {
        "command": "quicksync.syncWorkspace",
        "title": "Sync Workspace",
        "category": "QuickSync"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quicksync",
          "title": "QuickSync",
          "icon": "media/quicksync.svg"
        }
      ]
    },
    "views": {
      "quicksync": [
        {
          "id": "quicksyncRemote",
          "name": "Remote",
          "contextualTitle": "QuickSync Remote"
        }
      ]
    },
    "menus": {
      "editor/title": [
        { "command": "quicksync.syncCurrentFile", "when": "resourceScheme == file", "group": "navigation" }
      ],
      "explorer/context": [
        { "command": "quicksync.syncSelectedFiles", "when": "resourceScheme == file && !explorerResourceIsFolder", "group": "7_quicksync@1" },
        { "command": "quicksync.syncFolder", "when": "explorerResourceIsFolder", "group": "7_quicksync@1" }
      ],
      "view/title": [
        { "command": "quicksync.remote.connect", "when": "view == quicksyncRemote", "group": "navigation@1" },
        { "command": "quicksync.remote.refresh", "when": "view == quicksyncRemote", "group": "navigation@2" },
        { "command": "quicksync.remote.newFolder", "when": "view == quicksyncRemote", "group": "navigation@3" },
        { "command": "quicksync.remote.disconnect", "when": "view == quicksyncRemote", "group": "1_conn" }
      ],
      "view/item/context": [
        { "command": "quicksync.remote.download", "when": "view == quicksyncRemote && viewItem =~ /quicksync(File|Dir)/", "group": "1_transfer@1" },
        { "command": "quicksync.remote.uploadHere", "when": "view == quicksyncRemote && viewItem == quicksyncDir", "group": "1_transfer@2" },
        { "command": "quicksync.remote.newFile", "when": "view == quicksyncRemote && viewItem == quicksyncDir", "group": "2_create@1" },
        { "command": "quicksync.remote.newFolder", "when": "view == quicksyncRemote && viewItem == quicksyncDir", "group": "2_create@2" },
        { "command": "quicksync.remote.rename", "when": "view == quicksyncRemote && viewItem =~ /quicksync(File|Dir)/", "group": "3_modify@1" },
        { "command": "quicksync.remote.delete", "when": "view == quicksyncRemote && viewItem =~ /quicksync(File|Dir)/", "group": "3_modify@2" }
      ]
    },
    "configuration": {
      "title": "QuickSync SFTP",
      "properties": {
        "quicksync.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the sync button in the status bar"
        },
        "quicksync.autoUpload": {
          "type": "boolean",
          "default": false,
          "description": "Automatically upload changes after saving a remote-opened file (off by default)."
        },
        "quicksync.enterpriseMode": {
          "type": "boolean",
          "default": false,
          "description": "Require explicit confirmation for upload/overwrite/delete and enforce host-fingerprint pinning. Recommended for production servers."
        }
      }
    },
    "keybindings": [
      {
        "command": "quicksync.syncChanged",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "dependencies": {
    "ssh2-sftp-client": "^10.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.28.0"
  }
}
